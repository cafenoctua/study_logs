{
  "permissions": {
    "allow": [
      "Bash(forge build:*)", "Bash(forge run:*)", "Bash(forge test:*)", "Bash(forge seed:*)",
      "Bash(forge compile:*)", "Bash(forge ls:*)", "Bash(forge lint:*)", "Bash(forge bq-compat)",
      "Bash(forge query --read-only:*)",
      "Bash(cargo build:*)", "Bash(cargo test:*)", "Bash(cargo clippy:*)", "Bash(cargo fmt:*)",
      "Bash(make test)", "Bash(make lint)", "Bash(make dev)", "Bash(make ci)", "Bash(make bq-compat)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)"
    ],
    "deny": [
      "Read(./.env)", "Read(./.env.*)", "Read(./**/*.key)", "Read(./**/sa-*.json)",
      "Bash(forge * --target prod*)", "Bash(forge *--target=prod*)", "Bash(forge * -t prod*)",
      "Bash(FORGE_TARGET=prod*)",
      "Bash(forge ops:*)",
      "Bash(make deploy)", "Bash(bash scripts/deploy.sh:*)",
      "Bash(rm warehouse/*)", "Bash(rm -rf warehouse:*)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && cargo build --release -q -p guard", "timeout": 900 }] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR/target/release/guard\" protect-paths || exit 2" }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR/target/release/guard\" lint-sql" }] }
    ]
  }
}
